# Copiar este archivo como ".env.local" y completar para conectar la version local a un Supabase de PRUEBA.
# Sin este archivo, la version local funciona igual pero guarda todo solo en este navegador.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=pegar-la-anon-key
# Opcional: clave de Google Maps (Geocoding API) para los nombres de calles
VITE_GOOGLE_MAPS_KEY=
